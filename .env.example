# Turso (libSQL). Local dev can use: file:local.db
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=
# Google AI Studio key — enables auto-categorization and AI extraction fallback
GEMINI_API_KEY=
# Optional model override
GEMINI_MODEL=
# Login password for the app
APP_PASSWORD=
# 32+ random characters, signs the session cookie
SESSION_SECRET=
# Added automatically when a Vercel Blob store is connected
BLOB_READ_WRITE_TOKEN=
